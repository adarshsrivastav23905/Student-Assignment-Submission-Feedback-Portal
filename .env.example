# Application
FLASK_ENV=development
SECRET_KEY=replace-with-strong-secret
JWT_SECRET_KEY=replace-with-strong-jwt-secret
JWT_EXPIRY_HOURS=24
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///assignment_portal.db

# Storage
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,doc,txt,zip,png,jpg,jpeg

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000
